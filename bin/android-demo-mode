#!/bin/bash
# Reference: https://android.googlesource.com/platform/frameworks/base/+/master/packages/SystemUI/docs/demo_mode.md

set -euo pipefail

ACTION="$1"
TIME_PARAM="${2:-}"
ADB="${ADB:-adb}"

if [[ "$ACTION" != "on" && "$ACTION" != "off" ]]; then
  echo "Usage: $0 [on|off] [hhmm]" >&2
  exit 1
fi

# Enable global permission
"$ADB" shell settings put global sysui_demo_allowed 1

if [[ "$ACTION" == "on" ]]; then
  echo "Enabling Demo Mode..."

  # Enter demo mode
  "$ADB" shell am broadcast -a com.android.systemui.demo -e command enter > /dev/null
  sleep 2

  # Set clock if provided (force 4 digits)
  if [[ -n "$TIME_PARAM" ]]; then
    CLEAN_TIME=$(printf "%04d" "$TIME_PARAM")
    "$ADB" shell am broadcast -a com.android.systemui.demo -e command clock -e hhmm "$CLEAN_TIME" > /dev/null
  fi

  # Set battery (unplugged, 100%)
  "$ADB" shell am broadcast -a com.android.systemui.demo -e command battery -e plugged false > /dev/null
  "$ADB" shell am broadcast -a com.android.systemui.demo -e command battery -e level 100 > /dev/null

  # Set network icons
  "$ADB" shell am broadcast -a com.android.systemui.demo -e command network -e wifi show -e level 4 > /dev/null
  "$ADB" shell am broadcast -a com.android.systemui.demo -e command network -e mobile show -e datatype none -e level 4 > /dev/null

  # Hide notifications
  "$ADB" shell am broadcast -a com.android.systemui.demo -e command notifications -e visible false > /dev/null

elif [[ "$ACTION" == "off" ]]; then
  echo "Disabling Demo Mode..."
  "$ADB" shell am broadcast -a com.android.systemui.demo -e command exit > /dev/null
fi

exit 0
